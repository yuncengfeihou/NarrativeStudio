# StepFun API（必填）
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview

# 服务
PORT=3210
HOST=0.0.0.0

# ---- 上下文预算 ----
# 软目标 = 每轮装配的目标体积。它不随剧情增长上升（各层有独立配额）。
CONTEXT_SOFT_TOKENS=52000
# 硬上限 = 安全网，只在异常时兜底。
CONTEXT_MAX_TOKENS=200000

# 各层配额（token）。改小会让对应信息更容易被裁掉。
BUDGET_SYSTEM=1500
BUDGET_WORLD=3000
BUDGET_LORE=3000
BUDGET_SCENE=900
BUDGET_DIRECTOR=700
BUDGET_MEMORY=14000
BUDGET_RECENT=9000
BUDGET_RETRIEVAL=1500
BUDGET_CURRENT=2000

# 保留的最近原文轮数
RECENT_RAW_TURNS=4
RECENT_ARCS=6
RECENT_ROUNDS=6

# 检索
RETRIEVAL_TOP_K=5

# 词条触发扫描
LORE_SCAN_DEPTH=8
# 递归 0 = 关闭（推荐）。开启后，被触发词条的内容会再次参与扫描，
# 容易让「称呼礼法」这类词条顺带把整张卡司都拉进上下文。
LORE_RECURSION=0

# 压缩节奏
ARC_EVERY=6
SAGA_EVERY=4
CHRONICLE_EVERY=4
REFLECT_EVERY=5

# Agent 推理强度
NARRATOR_EFFORT=high
BRANCH_EFFORT=medium
MEMORY_EFFORT=low

# ---- 可选：嵌入模型（用于语义检索）。三项都填才会启用 ----
# EMBED_BASE_URL=https://api.example.com/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-3-small
