# StepFun API（必填）
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview

# 服务
PORT=3210
HOST=0.0.0.0

# LLM 传输层
LLM_TIMEOUT_MS=300000    # 单次请求超时（含长正文流式）
LLM_MAX_RETRIES=2        # 429/5xx/网络错误的重试次数

# SQLite 路径（留空 = data/roleplay.db）。测试请指向临时文件，不要指向生产库。
DB_PATH=

# ---- 模型配置（设置页可改，改完即时生效） ----
# 本文件里的 STEPFUN_* / *_EFFORT / *_TEMPERATURE / *_MAX_TOKENS / *_MODEL 是「种子默认」：
# 设置页保存过运行期配置后，以数据库（meta 表 runtime_config_v1）为准，无需重启即生效；
# DELETE /api/config 或设置页「恢复 .env 默认」会删掉这份运行期配置，回到本文件。
# 服务商 Base URL 与 API Key 在界面上增删；地址与 STEPFUN_BASE_URL 相同时留空 Key 会沿用本文件的 Key。

# ---- 上下文预算 ----
# 软目标 = 每轮装配的目标体积。它不随剧情增长上升（各层有独立配额）。
CONTEXT_SOFT_TOKENS=64000
# 硬上限 = 安全网，只在异常时兜底。
CONTEXT_MAX_TOKENS=200000
# 超硬上限策略：
#   fail（默认）= 拒绝本轮（SSE error），不把半句话送进模型；建议封场/换模型/调低 BUDGET_RECENT
#   truncate    = 旧行为：从最长非 system 消息截断到 70% 并记 degraded='over_hard_cap'（仅调试/应急）
CONTEXT_OVER_HARD_CAP=fail

# token 估算器校准系数。实测估算比上游 prompt_tokens 高估 1.40 倍，乘上它预算才准。
TOKEN_SCALE=0.72

# 各层配额（校准后的 token）。六层：系统 / 场次索引 / 场次细节 / 逐字原文 / 本场状态 / 本轮输入；
# 检索结果是 current 下的子层（模型主动取证，当拍蒸发）。
#   system        = 世界规则 + 故事方向 + 世界索引 + 主角（**只读模板快照，逐字节冻结**）
#   archive       = 【本局场次索引】一行一场，只追加（长程记忆的载体）
#   archiveDetail = 【刚才这一场怎么收的】最近 1–2 场细节
#   recent        = 当前场次逐字原文（按场次边界，不硬裁）
#   scene         = 本场状态：当前这一刻的世界状态（每场变一次，放在尾部注意力最强处）
#   retrieval     = 模型主动检索到的设定集全文（只进当拍）
#   current       = 本轮输入 + 尾注
#
# 滚动摘要已移除：1000 轮 × 1900 tok ≈ 190 万 tok 压进 1800 tok 需要 1056:1 的压缩比，
# 结构上做不到；长程记忆改由场次记录（scenes）+ 原文（turns）承担。
BUDGET_SYSTEM=3400
BUDGET_ARCHIVE=1800
BUDGET_ARCHIVE_DETAIL=900
BUDGET_RECENT=24000
BUDGET_SCENE=3000
BUDGET_RETRIEVAL=1000
BUDGET_CURRENT=2000

# 设定检索：auto = 只在大卡上启用；单会话 settings.codex_retrieval 可强制 on/off
RETRIEVAL_MIN_CODEX=24
RETRIEVAL_MAX_QUERIES=3

# 实体链接扫描最近几轮原文（只用于「玩家提到了谁」，不用于触发设定）
LORE_SCAN_DEPTH=8

# 后台 Agent 节奏
CONTINUITY_EVERY=10      # 每 N 轮跑一次一致性检查
WORLD_TICK_EVERY=8       # 预留：当前管线只在切场时跑后台推演，尚未按轮数消费
# 强制封场。为 0 会让「同一地点待 100 轮就一场都不关」，场次索引根本建不起来。
SCENE_EVERY=12           # 每 N 轮强制封场
SCENE_MAX_TOKENS=20000   # 单场原文 token 上限，超了也强制封场（场记 Agent 输入不能无限增长）

# 分段演绎（P1-1 第一阶段）
# single = 一次流式写完（默认）；segmented = 允许草稿/修订/codex_lookup 的小循环。
# 也可以只对某个会话开启：PATCH /api/sessions/:id {settings:{narration_mode:'segmented'}}
NARRATION_MODE=single
NARRATION_MAX_ROUNDS=6
# 注意：推理过程也计入 max_tokens；低于 NARRATOR_MAX_TOKENS 可能在长正文处截断
SEGMENTED_ROUND_MAX_TOKENS=12000
# 单条工具结果上限 / 工具消息总预算（只活在当拍，不写 turns）
TOOL_RESULT_MAX_TOKENS=500
BUDGET_TOOL_RESULTS=1200

# Agent 推理强度
#   narrator   写正文，永远不输出 JSON
#   archivist  记忆整理：每轮后抽取断言/状态/关系/线索/原声
#   sceneKeeper 本场状态：封场时从完整原文写场次记录（question/outcome/key_detail/causal/hooks）
#   continuity 一致性检查：定期查矛盾与知识越界
#   librarian  设定集维护：按需工具循环召回旧事
#   worldTick  后台推演：推演不在场角色的行动
#   retrieval  设定检索：判断这一拍要不要查设定集全文
#   cardSmith  世界卡生成：小说 → 世界卡的长任务
NARRATOR_EFFORT=high
ARCHIVIST_EFFORT=medium
SCENE_KEEPER_EFFORT=medium
CONTINUITY_EFFORT=medium
LIBRARIAN_EFFORT=low
WORLD_TICK_EFFORT=medium
RETRIEVAL_EFFORT=low
BRANCH_EFFORT=medium
CARD_SMITH_EFFORT=medium

# Agent 温度与单次输出上限（0–2；注释掉 = 内置默认）。
# 9 个 Agent：NARRATOR / ARCHIVIST / SCENE_KEEPER / CONTINUITY / LIBRARIAN / WORLD_TICK /
#             RETRIEVAL / BRANCH / CARD_SMITH
# 形如 <AGENT>_TEMPERATURE、<AGENT>_MAX_TOKENS，例如 NARRATOR_TEMPERATURE=0.88。
# 设置页里的「Agent 分配」可以按 Agent 覆盖模型、推理强度、温度、输出上限，优先级高于本文件。

# 可选：每个 Agent 单独指定模型（留空 = 跟随 STEPFUN_MODEL）
# 设置页按 Agent 绑定模型后以界面为准；这里是未保存运行期配置时的种子默认。
# 典型用法：旁路 Agent 用便宜模型，narrator 用最强模型。
# NARRATOR_MODEL=
# ARCHIVIST_MODEL=
# SCENE_KEEPER_MODEL=
# RETRIEVAL_MODEL=
# CONTINUITY_MODEL=
# LIBRARIAN_MODEL=
# WORLD_TICK_MODEL=
# BRANCH_MODEL=
# CARD_SMITH_MODEL=
