# StepFun API（必填）
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview

# 服务
PORT=3210
HOST=0.0.0.0

# ---- 上下文预算 ----
# 软目标 = 每轮装配的目标体积。它不随剧情增长上升（各层有独立配额）。
CONTEXT_SOFT_TOKENS=52000
# 硬上限 = 安全网，只在异常时兜底。
CONTEXT_MAX_TOKENS=200000

# 各层配额（token）。五层：系统 / 前情提要 / 最近原文 / 场记单 / 本轮输入；
# 检索结果是 current 下的子层（模型主动取证，当拍蒸发）。
#   system  = 契约 + 命题 + 宪章 + 世界索引（一个会话内几乎不变，吃前缀缓存）
#   summary = 前情提要：滚动摘要覆盖更早剧情（原文仍保留在 turns）
#   recent  = 最近若干轮逐字原文（只追加）
#   scene   = 场记单：当前这一刻的世界状态（每场变一次，放在尾部注意力最强处）
#   retrieval = 模型主动检索到的辞书全文（只进当拍）
#   current = 本轮输入 + 尾注
BUDGET_SYSTEM=3200
BUDGET_SUMMARY=1800
BUDGET_RECENT=9000
BUDGET_SCENE=2400
BUDGET_RETRIEVAL=600
BUDGET_CURRENT=2000

# 原文沉淀：摘要边界之后的原文超过 HIGH 就把最旧一批压进摘要，压到 LOW 以下；
# 至少保留 KEEP_RECENT 轮逐字，且无论 token 多少都不超过 MAX_RAW_TURNS 轮。
# 原文窗口不做字符串截断——先被摘要接住，才允许离开窗口。
SUMMARY_HIGH_TOKENS=12000
SUMMARY_LOW_TOKENS=8000
SUMMARY_KEEP_RECENT=4
SUMMARY_MAX_RAW_TURNS=12
SUMMARY_MIN_CHARS=2000

# 辞书主动检索：auto = 只在大卡上启用；单会话 settings.codex_retrieval 可强制 on/off
RETRIEVAL_MIN_CODEX=24
RETRIEVAL_MAX_QUERIES=3

# 实体链接扫描最近几轮原文（只用于「玩家提到了谁」，不用于触发设定）
LORE_SCAN_DEPTH=8

# 后台 Agent 节奏
CONTINUITY_EVERY=10      # 每 N 轮跑一次校勘
WORLD_TICK_EVERY=8       # 预留：当前管线只在切场时跑世界呼吸，尚未按轮数消费
SCENE_EVERY=0            # >0 时按固定轮数强制切场（0 = 只按状态变化切）

# 分段演绎（P1-1 第一阶段）
# single = 一次流式写完（默认）；segmented = 允许草稿/修订/codex_lookup 的小循环。
# 也可以只对某个会话开启：PATCH /api/sessions/:id {settings:{narration_mode:'segmented'}}
NARRATION_MODE=single
NARRATION_MAX_ROUNDS=6
# 注意：推理过程也计入 max_tokens；低于 NARRATOR_MAX_TOKENS 可能在长正文处截断
SEGMENTED_ROUND_MAX_TOKENS=12000
# 单条工具结果上限 / 工具消息总预算（只活在当拍，不写 turns）
TOOL_RESULT_MAX_TOKENS=500
BUDGET_TOOL_RESULTS=1200

# Agent 推理强度
#   narrator   写正文，永远不输出 JSON
#   archivist  史官：每轮后抽取断言/状态/关系/线索/原声
#   sceneKeeper 场记：切场时从完整原文写场次记录
#   continuity 校勘：定期查矛盾与知识越界
#   librarian  检索：按需工具循环召回旧事
#   worldTick  世界呼吸：推演不在场角色的行动
#   summarizer 前情提要：滚动摘要
#   retrieval  检索预检：判断这一拍要不要查辞书全文
#   cardSmith  制卡师：小说 → 世界卡的长任务
NARRATOR_EFFORT=high
ARCHIVIST_EFFORT=medium
SCENE_KEEPER_EFFORT=medium
CONTINUITY_EFFORT=medium
LIBRARIAN_EFFORT=low
WORLD_TICK_EFFORT=medium
SUMMARY_EFFORT=low
RETRIEVAL_EFFORT=low
BRANCH_EFFORT=medium
CARD_SMITH_EFFORT=medium

# 可选：每个 Agent 单独指定模型（留空 = 跟随 STEPFUN_MODEL）
# 典型用法：旁路 Agent 用便宜模型，narrator 用最强模型。
# NARRATOR_MODEL=
# ARCHIVIST_MODEL=
# SCENE_KEEPER_MODEL=
# SUMMARY_MODEL=           # summarizer
# RETRIEVAL_MODEL=
# CONTINUITY_MODEL=
# LIBRARIAN_MODEL=
# WORLD_TICK_MODEL=
# BRANCH_MODEL=
# CARD_SMITH_MODEL=
