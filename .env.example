# StepFun API（必填）
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview

# 服务
PORT=3210
HOST=0.0.0.0

# 上下文预算（硬上限 200K）
CONTEXT_MAX_TOKENS=200000
CONTEXT_SOFT_TOKENS=170000
RECENT_RAW_TURNS=4
RECENT_ARCS=8
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_TOKENS=16000

# 记忆压缩层级节奏
ARC_EVERY=5
SAGA_EVERY=5
CHRONICLE_EVERY=5

# Agent 推理强度
NARRATOR_EFFORT=high
BRANCH_EFFORT=medium
MEMORY_EFFORT=low
