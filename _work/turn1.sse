data: {"type":"memory","stats":{"round_summary":"伍卿在东街收破烂遇暴雨，被杂货铺主张兰驱赶。凌家女凌玥乘黑色商务车而至，当街喊他「卿儿」，扶住他并命随从购置男装菜肉，又一句话令张兰关铺。她握住伍卿的手称「你就是。跟我有关。」强行随他回村。村口茅草屋前，黎婆持旱烟杆与凌玥对峙，揭露七年前凌家将十岁的伍卿丢在十五路雨中。凌玥拱手行礼，直言「我是来提亲的」「名分先定下来」。她又精准说出伍卿左腿下雨疼的秘密，并盯上他贴身佩戴的乌黑玉佩。伍卿胸前玉佩骤然发烫，透出幽暗绿光，在衣襟下投下一个「凌」字。黎婆旱烟杆坠地，大黑牛低哞着将伍卿往凌玥方向轻推。凌玥伸手，令他在雨中选择一个。","entities":8,"facts":11,"relations":3,"threads":3,"reflection":null,"compressed":{"created":[],"archived":0},"usage":{"prompt_tokens":3731,"completion_tokens":4354,"total_tokens":8085,"cached_tokens":0,"reasoning_tokens":0,"ttft_ms":0,"duration_ms":66491,"output_chars":7426,"tps":65.5,"cache_rate":0},"context_tokens":15366,"context_max":200000,"turn_count":1,"notes":0,"reflections":0,"compression":1,"tiers":[{"level":1,"count":1,"tokens":290,"last":{"turn_from":1,"turn_to":1,"tokens":290}},{"level":2,"count":0,"tokens":0,"last":null},{"level":3,"count":0,"tokens":0,"last":null},{"level":4,"count":0,"tokens":0,"last":null}]}}

data: {"type":"state","state":{"time":"夏日·暴雨中","location":"村口茅草屋门外","weather":"夏日暴雨","tension":0.85,"characters":{"伍卿":{"mood":"混乱震惊","location":"家门外雨中","status":"身着凌玥赠新衣，左腿疼痛"},"凌玥":{"mood":"孤注一掷","location":"伍卿家门外雨中","status":"眼眶泛红"},"黎婆":{"mood":"愤怒震骇","location":"家门口","status":"旱烟杆坠地"}},"last_hook":"凌玥令伍卿在她与黎婆之间「选一个」，胸前玉佩透出「凌」字","inventory":["凌玥赠的新男装"],"quests":[{"goal":"弄清凌玥为何认识自己","progress":"她喊出小名「卿儿」并称「跟我有关」","status":"active"},{"goal":"应对凌玥的提亲","progress":"凌玥当黎婆面提出提亲，要求先定名分","status":"active"},{"goal":"查明七年前十五路旧事","progress":"黎婆揭露凌家曾将十岁的伍卿丢在十五路","status":"active"}]},"turn_no":1}

